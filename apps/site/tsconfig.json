{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true, "composite": false, "declaration": false, "allowJs": false,
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "preserve", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "isolatedModules": true, "incremental": false, "plugins": [{ "name": "next" }]
  },
  "include": ["next-types.d.ts", "app", "lib", "next.config.ts", ".next/types/**/*.ts"]
}
